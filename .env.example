PORT=10000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
DEVELOPER_EMAIL=developer@example.com
DEVELOPER_PASSWORD=replace-with-a-strong-password
# Generate a 32-byte key and provide it in Render for encrypted per-admin Cloudinary credentials.
CLOUDINARY_CREDENTIALS_KEY=replace-with-64-hex-characters
TRUST_PROXY=1
CLIENT_ORIGIN=http://localhost:5173
# Leave blank for local development (Vite proxies /api). Set this on Vercel to the Render API URL.
VITE_API_BASE_URL=

